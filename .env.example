# ============================================================
# CollabCanvas Pro – Environment Variables
# ============================================================

# Firebase Project Config (from Firebase Console → Project Settings → Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=collabcanvas-pro.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=collabcanvas-pro
VITE_FIREBASE_STORAGE_BUCKET=collabcanvas-pro.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# FastAPI Backend REST & WebSockets API Server URL (Render Deployment)
VITE_API_URL=https://whiteboard-backend-10ji.onrender.com
